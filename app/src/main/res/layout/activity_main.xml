<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainMenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/mainTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:padding="90dp"
        android:text="Car Meets App"
        android:textAlignment="center"
        android:textColor="#3A76FA"
        android:textSize="34sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/carMeetImage"
        android:layout_width="250dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Car meet image"
        android:scaleType="center"
        android:src="@drawable/car_meet" />

    <Button
        android:id="@+id/viewMeetsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#3A76FA"
        android:text="View car meets"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/addMeetButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#3A76FA"
        android:text="Add Car meets"
        android:textColor="#FFFFFF" />
</LinearLayout>